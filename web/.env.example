# Copy this file to .env (local dev) or .env.production (prod build) and
# fill in real values. Both VITE_-prefixed vars below are bundled into the
# browser build, so only put non-secret, public-safe values here — never an
# API key, token, or credential.

# API base path the admin panel calls (relative path is fine behind a reverse proxy)
VITE_API_URL=/api/v1

# Absolute backend origin — used for Google OAuth redirect, must never be relative
VITE_BACKEND_URL=http://localhost:3000
