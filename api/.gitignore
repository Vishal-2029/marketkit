*.pem
*.key
secrets/*
!secrets/.gitkeep
!secrets/*.example
tmp/
uploads/*
!uploads/videos/
!uploads/photos/
uploads/videos/*
uploads/photos/*
!uploads/videos/.gitkeep
!uploads/photos/.gitkeep
