# Live/production environment template. Copy to api/.env.live and fill in real values.
# NEVER commit the filled-in file — api/.gitignore ignores .env.* except *.example files.

# Server
PORT=3000
APP_ENV=production

# Database — Docker service name 'postgres'.
# sslmode=disable is intentional here: this connection never leaves the
# Docker host's private bridge network (postgres has no published port in
# docker-compose.yml). If you ever point DATABASE_URL at a remote/managed
# Postgres instead of the bundled container, use sslmode=require (or
# verify-full) instead — traffic to a remote host must be encrypted.
DATABASE_URL=postgres://admin:change-this-password@postgres:5432/marketkit?sslmode=disable

# JWT
JWT_SECRET=change-this-to-a-random-32-char-secret

JWT_EXPIRY=8h

# Security — Secure flag on refresh-token cookies. Defaults to true whenever
# APP_ENV isn't "development", but set it explicitly here so it's obvious
# from this file alone that production cookies are locked down.
SECURE_COOKIE=true

# SMTP — Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=your@gmail.com

# CORS
CORS_ORIGIN=https://your-domain.tld,https://www.your-domain.tld

# Frontend — OAuth redirects here after Google login (must be public URL, not localhost)
FRONTEND_URL=https://your-domain.tld

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=4294967296

# Cache — Docker service name 'redis'
REDIS_URL=redis://redis:6379

SERVER_BASE_URL=https://your-domain.tld

# Cloudflare R2 — leave empty for local disk only; fill all values + restart for hybrid (new uploads → R2, legacy → disk)
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_PUBLIC_BASE=
# STORAGE_LOCAL_ONLY=true

# Postgres (Docker)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=marketkit

# Admin login — required, no default. Set a strong password before first boot.
ADMIN_EMAIL=admin@your-domain.tld
ADMIN_NAME=Super Admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# Google OAuth
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_REDIRECT_URL=https://your-domain.tld/api/v1/auth/google/callback
GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
# Web OAuth client from Firebase/Google Cloud (google_sign_in serverClientId / ID token aud)
GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com

# Razorpay (Live)
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx
PUBLISH_SECRET=xxxx
