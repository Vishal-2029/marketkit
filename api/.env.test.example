# Test environment (Razorpay Test mode)
# Copy to api/.env.test and fill values.

PORT=3000
DATABASE_URL=postgres://admin:password@localhost:5432/marketkit?sslmode=disable

JWT_SECRET=change-this-to-a-random-32-char-secret
JWT_EXPIRY=8h

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
ADMIN_EMAIL=noreply@example.com

# ── Payments ─────────────────────────────────────────────────────────────────
# Active gateway. One of the providers registered in internal/payments.
PAYMENT_PROVIDER=razorpay
# ISO-4217 currency every amount is charged in. The kit runs ONE currency per
# deployment — all *_in_paise columns hold this currency's minor unit
# (paise for INR, cents for USD).
PAYMENT_CURRENCY=INR

# Razorpay (Test)
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx

CORS_ORIGIN=http://localhost:5173,http://localhost:8081
SERVER_BASE_URL=http://localhost:3000

