# Server
PORT=3000
APP_ENV=development

# Database
DATABASE_URL=postgres://admin:password@localhost:5432/marketkit?sslmode=disable

# JWT
JWT_SECRET=change-this-to-a-random-32-char-secret
JWT_EXPIRY=8h

# SMTP — Gmail example (generate an App Password at myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=your@gmail.com

# Admin login — required to create the initial admin account (no hardcoded default).
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# ── Payments ─────────────────────────────────────────────────────────────────
# Active gateway. One of the providers registered in internal/payments.
PAYMENT_PROVIDER=razorpay
# ISO-4217 currency every amount is charged in. The kit runs ONE currency per
# deployment — all *_minor columns hold this currency's minor unit
# (minor units for INR, cents for USD).
PAYMENT_CURRENCY=INR

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx

# Stripe — only needed when PAYMENT_PROVIDER=stripe.
# Secret key (sk_...) — server only, never expose.
STRIPE_SECRET_KEY=
# Publishable key (pk_...) — returned to clients, safe to expose.
STRIPE_PUBLISHABLE_KEY=
# Endpoint signing secret (whsec_...) from Stripe Dashboard -> Webhooks.
STRIPE_WEBHOOK_SECRET=


# Google OAuth
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com

# Push notifications (FCM V1 — path to a Firebase service account JSON; leave default to disable)
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json

# Set true behind HTTPS in production so auth cookies get the Secure flag
SECURE_COOKIE=false

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# Frontend — where OAuth redirects the browser after Google login
FRONTEND_URL=http://localhost:5173

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=4294967296

SERVER_BASE_URL=http://localhost:3000

# Cache — leave empty to disable caching
REDIS_URL=

# Used by scripts/publish-apk.sh to upload APK builds without a JWT
PUBLISH_SECRET=xxxx

# Cloudflare R2 — leave empty for local-only; fill all fields for hybrid (new uploads → R2, legacy → disk)
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_PUBLIC_BASE=
# STORAGE_LOCAL_ONLY=true

# Postgres (for docker-compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=marketkit
