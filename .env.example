# Root-level .env — read by `docker compose` itself for ${VAR} substitution
# inside docker-compose.yml (POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB,
# PORT). This is DIFFERENT from api/.env, which is only read by the API
# process inside its container (via env_file:) — variables set there are NOT
# visible to docker-compose's own ${VAR} interpolation.
#
# Both api/.env's DATABASE_URL and this file's POSTGRES_USER/POSTGRES_PASSWORD
# must reference the SAME credentials, or the API container won't be able to
# reach Postgres. Copy this file to `.env` (repo root, next to
# docker-compose.yml) and fill in real values before running
# `docker compose up` / `make deploy` in production. Never commit the real
# `.env` — it's gitignored.

POSTGRES_USER=marketkit
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=changeme_use_a_strong_random_value
POSTGRES_DB=marketkit

# Host port the API is published on (bound to 127.0.0.1 only — nginx is the
# public ingress). Only change if 3000 is already in use on the host.
PORT=3000
